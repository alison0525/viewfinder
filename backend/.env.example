# HMAC 서명에 사용할 32바이트 이상 랜덤 비밀키 지정
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Next.js 프런트 개발 서버 Origin 지정. 여러 Origin은 쉼표로 구분
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 카카오 Developers 앱의 REST API 키를 OAuth2 Client ID로 사용
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
# 카카오 Developers에서 Client Secret을 활성화한 경우에만 실제 값을 입력
KAKAO_CLIENT_SECRET=
